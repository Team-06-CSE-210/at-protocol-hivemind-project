# Environment of the production Hivemind PDS (the official atproto PDS, version
# 0.0.0-spaces-alpha-20261105160032). Copy to pds.env on the server; never commit the filled file.
# Values without a secret match core/hivemind_pds/pds_config.ts.

PDS_HOSTNAME=pds.hivemind-network.com
PDS_PORT=2583
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_DID_PLC_URL=https://plc.directory
PDS_INVITE_REQUIRED=true
PDS_CRAWLERS=https://bsky.network

# Secrets: generate on the server, store only there
PDS_ADMIN_PASSWORD=
PDS_JWT_SECRET=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
