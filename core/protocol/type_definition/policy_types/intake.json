{
  "spaceType": "com.hivemind-network.space.intake",
  "description": "The coordinator's single inbox. Requesters write requests and agents write offers; only the coordinator reads.",
  "policy": {
    "$type": "com.atproto.managedspace.policy",
    "managingApp": "{coordinator}#hivemind_coordinator",
    "publishPolicy": false
  },
  "spaceKey": "main",
  "read": ["coordinator"],
  "write": {
    "com.hivemind-network.requester.request": ["requester"],
    "com.hivemind-network.agent.offer": ["agent"]
  }
}
