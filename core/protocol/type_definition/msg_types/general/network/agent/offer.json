{
  "lexicon": 1,
  "id": "com.hivemind-network.agent.offer",
  "defs": {
    "main": {
      "type": "record",
      "description": "An agent's answer to a dispatch. Written into the coordinator's offer intake space; neither the requester nor other agents can read it. Deleting it withdraws the offer.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["taskId", "decision", "createdAt"],
        "properties": {
          "taskId": { "type": "ref", "ref": "com.hivemind-network.defs#taskId" },
          "decision": { "type": "string", "enum": ["accept", "decline"] },
          "payload": {
            "type": "union",
            "refs": [],
            "description": "Required when decision is accept: the task type's #offer object, e.g. com.hivemind-network.mobility.ride#offer. These are the terms the agent commits to."
          },
          "declineReason": {
            "type": "string",
            "knownValues": ["busy", "outOfArea", "insufficientCapacity", "other"],
            "maxLength": 64
          },
          "snapshot": { "type": "ref", "ref": "#agentSnapshot" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "agentSnapshot": {
      "type": "object",
      "description": "The agent's state when it answered.",
      "properties": {
        "position": { "type": "ref", "ref": "com.hivemind-network.defs#geoPoint" },
        "batteryPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "operationalStatus": {
          "type": "string",
          "knownValues": ["available", "busy", "charging", "maintenance"],
          "maxLength": 64
        }
      }
    }
  }
}
