{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": [
		"core/**/*.ts",
		"services/**/*.ts",
		"hivemind_sdk/**/*.ts",
		"demo/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts"
	]
}
