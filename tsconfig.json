{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"strict": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"],
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": [
		"protocol/**/*.ts",
		"hivemind_library/**/*.ts",
		"services/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts"
	]
}
