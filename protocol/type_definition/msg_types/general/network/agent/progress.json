{
  "lexicon": 1,
  "id": "network.hivemind.agent.progress",
  "defs": {
    "main": {
      "type": "record",
      "description": "Progress of the assigned agent on its task (the ROS action feedback; completed or failed is the result). Written into the task space, one record per update.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["status", "createdAt"],
        "properties": {
          "status": {
            "type": "string",
            "knownValues": ["accepted", "enRoute", "arrived", "inProgress", "completed", "failed"],
            "maxLength": 64
          },
          "position": { "type": "ref", "ref": "network.hivemind.defs#geoPoint" },
          "eta": {
            "type": "string",
            "format": "datetime",
            "description": "When the agent expects to reach its next status (arrived while enRoute, completed while inProgress)."
          },
          "note": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
